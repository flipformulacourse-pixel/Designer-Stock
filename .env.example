# Kopiér til .env.local til lokal udvikling, og læg de samme værdier ind i Vercel → Settings → Environment Variables.

# Stripe → Udviklere → API-nøgler. Brug sk_test_... til test og sk_live_... når I går live.
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe → Udviklere → Webhooks → jeres endpoint → Signeringshemmelighed
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Jeres domæne uden skråstreg til sidst. Kan udelades – så bruges den adresse, siden kører på.
SITE_URL=https://designerstock.dk

# Sæt til true når I har lagt et link til handelsbetingelserne i Stripe
# (Indstillinger → Offentlige oplysninger → Servicevilkår). Så skal kunden også krydse af i Stripe.
STRIPE_TERMS_CONSENT=false


# Dashboard (/admin.html): fælles adgangskode til ejerne – mindst 10 tegn, gerne længere
ADMIN_PASSWORD=skift-mig-til-noget-langt

# Valgfri: hemmelig nøgle til login-cookien. Skift den for at logge alle ud.
ADMIN_SECRET=

# Billed-upload: oprettes automatisk når I tilføjer en Blob-database i Vercel → Storage
BLOB_READ_WRITE_TOKEN=
